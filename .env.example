# RetroPhone API Keys
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# OpenAI — for GPT intelligence and Whisper STT (legacy fallback)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# ElevenLabs — for Conversational AI, TTS voices, and sound effects
# Get yours at: https://elevenlabs.io (Starter tier or above recommended)
ELEVENLABS_API_KEY=your_key_here

# Spotify — for music search and playback (requires Premium account)
# Create an app at: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_id_here
SPOTIPY_CLIENT_SECRET=your_secret_here

# Optional: Weather location (default: Tallinn)
# WEATHER_LOCATION=Prague
